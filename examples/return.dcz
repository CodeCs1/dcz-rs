##
    Nested return
##

##
    func test() -> i32 {
        if a == 3 return 0;
        return 1;
    }

    LLVM based:

    func test() -> i32 {
        i32 ret1 = 1;
        if a == 3 ret1 = 0;
        return 1;
    }

##


func test() -> i8* { return "OK"; }

extern func pri32f(i8* str) -> i32;

func main() -> i32 {
    pri32f(test());
    return 0;
}