##
    Nested return
##

##
    func test() -> int {
        if a == 3 return 0;
        return 1;
    }

    LLVM based:

    func test() -> int {
        int ret1 = 1;
        if a == 3 ret1 = 0;
        return 1;
    }

##


func test() -> char* { return "OK"; }

extern func printf(char* str) -> int;

func main() -> int {
    printf(test());
    return 0;
}